rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alphartist222@gmail.com' ||
        (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'description', 'icon']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100 &&
        data.description is string && data.description.size() <= 500 &&
        data.icon is string && data.icon.size() <= 50;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'categoryId', 'shortDescription', 'fullDescription', 'specifications', 'price', 'currency', 'imageUrl', 'inStock', 'rating', 'featured']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 150 &&
        data.categoryId is string && data.categoryId.size() <= 100 &&
        data.shortDescription is string && data.shortDescription.size() <= 400 &&
        data.fullDescription is string && data.fullDescription.size() <= 4000 &&
        data.specifications is map &&
        data.price is number && data.price >= 0 &&
        data.currency is string && data.currency.size() <= 10 &&
        data.imageUrl is string && data.imageUrl.size() <= 1000 &&
        data.inStock is bool &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        data.featured is bool;
    }

    function isValidContact(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'subject', 'message', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 3000 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Contact Inquiries Collection
    match /contact_submissions/{submissionId} {
      allow create: if isValidId(submissionId) && isValidContact(incoming());
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
